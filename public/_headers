# Hashed build assets never change: cache them for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images and favicons keep stable names that could be replaced: cache for a week
/imgs/*
  Cache-Control: public, max-age=604800

/favicon/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://blog-api.diegopertusa.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
